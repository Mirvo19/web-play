[Unit]
Description=HC CDN Player — Unified Web + Job Supervisor (Gunicorn)
Documentation=https://github.com/your-org/hc-cdn-player
After=network.target
# Single-process model: this ONE unit serves HTTP AND runs background jobs
# (transcode, CDN upload, cleanup) on in-process executor threads.
# hc-cdn-worker.service no longer exists — disable and remove it (see MIGRATION.md).

[Service]
# --- Run as a dedicated non-root user ---
# Create with: sudo useradd --system --no-create-home --shell /usr/sbin/nologin hc-cdn
User=hc-cdn
Group=www-data

WorkingDirectory=/opt/hc-cdn-player

# Load all secrets and config from the .env file
EnvironmentFile=/opt/hc-cdn-player/.env

# Create the runtime socket directory automatically (owned by hc-cdn:www-data)
RuntimeDirectory=hc-cdn-player
RuntimeDirectoryMode=0750

# Ensure log + work directories exist (quarantine sibling must exist too:
# with ProtectSystem=strict only ReadWritePaths are writable, so an
# unlisted /tmp/torrent-quarantine fails boot with EROFS — see #1 below)
ExecStartPre=/bin/mkdir -p /var/log/hc-cdn-player
ExecStartPre=/bin/chown hc-cdn:www-data /var/log/hc-cdn-player
ExecStartPre=/bin/mkdir -p /tmp/video-processing
ExecStartPre=/bin/mkdir -p /tmp/torrent-quarantine
ExecStartPre=/bin/chown hc-cdn:www-data /tmp/video-processing /tmp/torrent-quarantine

ExecStart=/opt/hc-cdn-player/venv/bin/gunicorn \
    --config /opt/hc-cdn-player/gunicorn.conf.py \
    "run:app"

# Mark the unit ready only once the app answers its readiness probe.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do curl -sf --unix-socket /run/hc-cdn-player/gunicorn.sock http://localhost/ready && exit 0; sleep 2; done; exit 1'

# Graceful shutdown: SIGTERM stops job polling, terminates in-flight
# ffmpeg, awaits executor threads (up to TimeoutStopSec), then exits.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=90

# Graceful reload on SIGHUP (e.g.: sudo systemctl reload hc-cdn-player)
ExecReload=/bin/kill -s HUP $MAINPID

# Restart policy
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Resource controls — web + ffmpeg share one cgroup now. Size for your box:
# ~120 MB web worker + up to ~1.5 GB ffmpeg during encodes.
MemoryMax=1800M

# Security hardening (optional but recommended)
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ReadWritePaths=/opt/hc-cdn-player /var/log/hc-cdn-player /run/hc-cdn-player /tmp/video-processing /tmp/torrent-quarantine

[Install]
WantedBy=multi-user.target
