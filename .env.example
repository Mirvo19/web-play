# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key

# Server-Side CDN API Key Encryption Key (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CDN_ENCRYPTION_KEY=gK7xL8vM9nP0qR1sT2uV3wX4yZ5aB6cD7eF8gH9iJ0k=

# Database Connection
DATABASE_URL=sqlite:///app.db

# Supabase Auth Configuration (Required for user authentication)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Processing & Server Configuration
UPLOAD_FOLDER=/tmp/video-processing
HLS_SEGMENT_DURATION=6
DEFAULT_FFMPEG_THREADS=40
MAX_CONCURRENT_JOBS=1

# Maximum upload file size enforced at application level (GB)
MAX_UPLOAD_SIZE_GB=4

# Maximum RAM budget for video processing workloads (MB).
# The worker service systemd MemoryMax should be >= this value.
# On a 2 GB RAM server, 1500 MB leaves ~500 MB for the OS and web process.
PROCESSING_RAM_BUDGET_MB=1500

# Set to true to echo job logs to stdout (useful for journald/debugging)
LOG_TO_STDOUT=false
