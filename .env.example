# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
# REQUIRED in production (min 32 chars, not a placeholder — the app refuses
# to boot otherwise). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE-WITH-64-HEX-CHARS
JWT_SECRET_KEY=REPLACE-WITH-64-HEX-CHARS

# Server-Side CDN API Key Encryption Key (REQUIRED in production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CDN_ENCRYPTION_KEY=REPLACE-WITH-FERNET-KEY

# Database Connection
DATABASE_URL=sqlite:///app.db

# Supabase Auth Configuration (REQUIRED in production for user authentication)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Loopback-only dev login when Supabase is unconfigured. NEVER enable in
# production — startup validation refuses to boot with it set.
ALLOW_INSECURE_DEV_AUTH=false

# Processing & Server Configuration
UPLOAD_FOLDER=/tmp/video-processing
HLS_SEGMENT_DURATION=6
DEFAULT_FFMPEG_THREADS=40
MAX_CONCURRENT_JOBS=1

# Maximum upload file size enforced at application level (GB, real byte-count)
MAX_UPLOAD_SIZE_GB=4

# Maximum RAM budget for video processing workloads (MB).
# The systemd MemoryMax should be >= this value.
# On a 2 GB RAM server, 1500 MB leaves ~500 MB for the OS and web process.
PROCESSING_RAM_BUDGET_MB=1500

# --- Single-process scheduler (new) ---
# The app runs its own job supervisor in-process. Set to 'false' for a
# web-only process with no background execution.
ENABLE_JOB_SCHEDULER=true
# Seconds between job-queue polls.
JOB_POLL_INTERVAL=2.0
# Hard timeout per ffmpeg variant encode (seconds). Stalled encodes are
# killed and the job marked failed.
FFMPEG_VARIANT_TIMEOUT_SEC=7200
# Gunicorn HTTP workers. Keep 1 so exactly one scheduler/ffmpeg pool runs.
# Raise only if you size RAM/CPU for N ffmpeg pools (claims stay atomic).
WEB_CONCURRENCY=1

# CDN upload resilience: retries per file on transient network/TLS blips
# (dropped connections, timeouts, 429/5xx) with exponential backoff.
CDN_UPLOAD_RETRIES=4
CDN_UPLOAD_BACKOFF_SEC=1.5

# --- Torrent ingestion (isolated aria2c engine; requires `aria2` installed) ---
# Quarantine root; empty = <UPLOAD_FOLDER>/../torrent-quarantine (never inside
# UPLOAD_FOLDER, so the orphan-workspace sweep can't touch it).
TORRENT_QUARANTINE_FOLDER=
TORRENT_ENABLED=true
TORRENT_MAX_CONCURRENT=1
TORRENT_MAX_TOTAL_MB=4096
TORRENT_MAX_PEERS=50
TORRENT_BANDWIDTH_KBPS=0
TORRENT_TIMEOUT_SEC=7200
TORRENT_METADATA_TIMEOUT_SEC=120

# Logging: DEBUG, INFO (default), WARNING, ERROR. All logs go to stderr
# as single parseable lines (journald picks them up automatically).
LOG_LEVEL=INFO
