# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key

# Server-Side CDN API Key Encryption Key (Fernet key - generate with cryptography.fernet.Fernet.generate_key().decode())
CDN_ENCRYPTION_KEY=gK7xL8vM9nP0qR1sT2uV3wX4yZ5aB6cD7eF8gH9iJ0k=

# Database Connection (Local SQLite database - No PostgreSQL connection string needed)
DATABASE_URL=sqlite:///app.db

# Supabase Auth Configuration (Required for user authentication)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Processing & Server Configuration
UPLOAD_FOLDER=/tmp/video-processing
HLS_SEGMENT_DURATION=6
DEFAULT_FFMPEG_THREADS=40
MAX_CONCURRENT_JOBS=1
